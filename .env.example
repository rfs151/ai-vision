# Copy to .env and edit.  docker compose reads it automatically.

# ZLM API secret, shared by ZLM and the control service. Generate one: openssl rand -hex 16
ZLM_SECRET=change-me

# Public IP of the server, announced to browsers for WebRTC. Empty = ZLM uses the local interface IP
# (fine on a VPS whose interface has the public IP, e.g. Vultr; set it behind NAT / on cloud with private IPs)
PUBLIC_IP=

# Ports (host networking). Open in the firewall: API_PORT, ZLM_HTTP_PORT (tcp), ZLM_RTC_PORT (tcp+udp),
# and ZLM_RTSP_PORT / ZLM_RTMP_PORT only if cameras push from outside.
API_PORT=8090
ZLM_HTTP_PORT=80
ZLM_RTSP_PORT=554
ZLM_RTMP_PORT=1935
ZLM_RTC_PORT=8000

# Time zone for alarm times, file names and logs
TZ=Asia/Shanghai

MAX_WORKERS=8
# Extra args for every worker, e.g. --det-fps 3 to save CPU
WORKER_ARGS=

# Alarm snapshots + clips (data/alarms, data/clips): delete files older than N days, and the
# oldest ones beyond N GB in total. Checked every hour. 0 = no limit.
MEDIA_KEEP_DAYS=7
MEDIA_MAX_GB=5

# ---- Build sources. Leave empty abroad; in mainland China for example: ----
# ZLM_IMAGE=docker.1ms.run/zlmediakit/zlmediakit:master
# REGISTRY=docker.1ms.run/library/
# PIP_INDEX=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com
# APT_MIRROR=mirrors.aliyun.com
# TORCH_INDEX=https://mirrors.aliyun.com/pytorch-wheels/cpu/
# MODEL_URL=https://modelscope.cn/models/Ultralytics/YOLO11/resolve/master/yolo11n.pt
# Proxy for downloading the demo videos from GitHub, if needed
# DOWNLOAD_PROXY=http://127.0.0.1:12334

# Where data is stored on the host
# DATA_PATH=./data
